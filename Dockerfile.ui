FROM python:3.14-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src /app/src
COPY main.py /app/main.py

# Train the router at build time so the dashboard loads instantly.
RUN python -m src.models.train_router

EXPOSE 8501

CMD ["python", "main.py", "ui"]
